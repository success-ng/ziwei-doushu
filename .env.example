# 复制为 .env.local 后填入实际值

# ─── Dịch bài luận v4.0 sang tiếng Việt (OpenAI-compatible, chọn một) ───
# Giao diện tiếng Việt gọi dịch ở server và ghi data/v4/cache/. Khóa không gửi ra trình duyệt.
# Để trống thì vẫn hiện nguyên văn tiếng Trung. Bản mở không có /api/interpret.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── Hoặc dùng OpenAI (mặc định gpt-4o-mini; BASE_URL và MODEL có thể bỏ) ───
# AI_PROVIDER=openai
# OPENAI_API_KEY=your-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
